<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, {threshold: 0.15});
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  const modal = document.getElementById('modal');
  const modalMsg = document.getElementById('modal-msg');

  document.querySelectorAll('.egg').forEach(egg => {
    egg.addEventListener('click', () => {
      modalMsg.textContent = egg.dataset.msg;
      modal.classList.add('active');
    });
  });

  function closeModal(){
    modal.classList.remove('active');
  }
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  (function(){
    const canvas = document.getElementById('hearts-bg');
    const ctx = canvas.getContext('2d');
    let w, h;

    function resize(){
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    const labels = ['Tvizi', 'Ficha', 'Tvizi', 'Ficha', 'Tvizi ❤ Ficha'];

    class Heart {
      constructor(){ this.reset(true); }
      reset(initial = false){
        this.x = Math.random() * w;
        this.y = initial ? Math.random() * h : -80 - Math.random() * 120;
        this.size = 34 + Math.random() * 42;
        this.speed = 0.25 + Math.random() * 0.55;
        this.rotation = Math.random() * Math.PI * 2;
        this.rotSpeed = (Math.random() - 0.5) * 0.008;
        this.sway = Math.random() * Math.PI * 2;
        this.swaySpeed = 0.002 + Math.random() * 0.004;
        this.swayAmp = 0.3 + Math.random() * 0.7;
        this.opacity = 0.10 + Math.random() * 0.18;
        this.label = labels[Math.floor(Math.random() * labels.length)];
        this.hue = 0.28 + Math.random() * 0.06;
      }
      update(){
        this.y += this.speed;
        this.sway += this.swaySpeed;
        this.x += Math.sin(this.sway) * this.swayAmp;
        this.rotation += this.rotSpeed;
        if (this.y > h + 100 || this.x < -120 || this.x > w + 120) this.reset();
      }
      draw(){
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.rotation);
        ctx.globalAlpha = this.opacity;
        const s = this.size;
        ctx.beginPath();
        const top = -s * 0.35;
        ctx.moveTo(0, top + s * 0.2);
        ctx.bezierCurveTo(0, top, -s * 0.5, top, -s * 0.5, top + s * 0.35);
        ctx.bezierCurveTo(-s * 0.5, top + s * 0.7, 0, top + s * 0.95, 0, top + s * 1.2);
        ctx.bezierCurveTo(0, top + s * 0.95, s * 0.5, top + s * 0.7, s * 0.5, top + s * 0.35);
        ctx.bezierCurveTo(s * 0.5, top, 0, top, 0, top + s * 0.2);
        ctx.closePath();
        ctx.fillStyle = `hsla(${this.hue * 360}, 100%, 65%, 0.9)`;
        ctx.fill();
        ctx.strokeStyle = `hsla(${this.hue * 360}, 100%, 80%, 0.9)`;
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.globalAlpha = Math.min(0.65, this.opacity * 3);
        ctx.fillStyle = '#0D0D0D';
        ctx.font = `600 ${Math.max(8, s * 0.22)}px 'Nunito', sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(this.label, 0, top + s * 0.55);
        ctx.restore();
      }
    }

    const count = Math.min(38, Math.floor((w * h) / 28000));
    const hearts = Array.from({length: count}, () => new Heart());

    function loop(){
      ctx.clearRect(0, 0, w, h);
      hearts.forEach(hh => { hh.update(); hh.draw(); });
      requestAnimationFrame(loop);
    }
    loop();
  })();
</script>
</body>

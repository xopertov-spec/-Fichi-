<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Для Ники</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;600;700&family=Nunito:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-dark:#0D0D0D;
    --bg-card:#1A1A1A;
    --bg-card-2:#121212;
    --text-main:#E0E0E0;
    --text-muted:#A0A0A0;
    --accent:#A8FF60;
    --accent-dark:#7CB342;
    --accent-glow:rgba(168,255,96,.25);
    --border-subtle:#2A2A2A;
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:radial-gradient(circle at top, #141414 0%, var(--bg-dark) 60%);
    color:var(--text-main);
    font-family:'Nunito',sans-serif;
    font-weight:400;
    line-height:1.7;
    overflow-x:hidden;
  }

  #hearts-bg{
    position:fixed;
    inset:0;
    width:100%;
    height:100%;
    z-index:0;
    pointer-events:none;
  }

  .page{position:relative;z-index:1;}

  ::selection{background:var(--accent);color:var(--bg-dark);}

  h1,h2{
    font-family:'Comfortaa',cursive;
    font-weight:700;
    letter-spacing:.02em;
    color:var(--accent);
    text-shadow:0 0 10px var(--accent-glow);
  }
  h1{font-size:clamp(2rem,5vw,3.2rem);}
  h2{font-size:clamp(1.4rem,3vw,1.9rem);margin-bottom:1rem;}
  h3{
    font-family:'Comfortaa',cursive;
    font-size:1.05rem;font-weight:600;
    color:var(--accent);letter-spacing:0;text-shadow:none;margin-bottom:.6rem;
  }

  p{margin-bottom:1rem;color:var(--text-main);}
  small,.muted{color:var(--text-muted);font-size:.9rem;}

  a{color:var(--accent);text-decoration:none;border-bottom:1px dotted var(--accent);transition:all .25s ease;}
  a:hover{color:#C4FF8A;border-bottom-color:transparent;}

  .container{max-width:880px;margin:0 auto;padding:0 1.5rem;}
  section{padding:3.5rem 0;position:relative;}

  .hero{
    display:flex;align-items:center;justify-content:center;
    text-align:center;
    padding:4rem 1.5rem 3rem;
  }
  .hero-inner{max-width:720px;}
  .hero h1{margin-bottom:1.2rem;}
  .hero .subtitle{
    font-size:1.05rem;color:var(--text-muted);
    max-width:560px;margin:0 auto;
  }

  .card{
    background:var(--bg-card);
    border:1px solid var(--border-subtle);
    border-radius:12px;
    padding:1.6rem;
    margin-bottom:1.1rem;
    transition:all .35s ease;
  }
  .card:hover{
    border-color:var(--accent);
    box-shadow:0 0 18px var(--accent-glow);
    transform:translateY(-2px);
  }
  .card ul{list-style:none;padding:0;}
  .card ul li{
    padding-left:1.2rem;position:relative;margin-bottom:.5rem;
  }
  .card ul li::before{
    content:"›";color:var(--accent);position:absolute;left:0;
    font-weight:700;
  }

  .quote{
    border-left:2px solid var(--accent);
    padding:.5rem 0 .5rem 1.1rem;
    margin-bottom:1.2rem;
    font-style:italic;
    color:var(--text-main);
  }
  .quote .author{display:block;margin-top:.35rem;font-style:normal;font-size:.85rem;color:var(--text-muted);}

  .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease, transform .7s ease;}
  .reveal.visible{opacity:1;transform:translateY(0);}

  .divider{
    height:1px;
    background:linear-gradient(to right, transparent, var(--accent), transparent);
    opacity:.4;
    margin:0 auto;
    max-width:180px;
  }

  .accent-block{
    border-left:3px solid var(--accent);
    background:linear-gradient(to right, rgba(168,255,96,.06), transparent);
    padding:1.8rem 1.6rem;
    border-radius:0 12px 12px 0;
    margin:1.5rem 0;
  }
  .accent-block p{
    font-size:1.05rem;
    color:var(--text-main);
    font-style:italic;
    margin:0;
  }

  .appreciate-list{
    list-style:none;
    padding:0;
    counter-reset:appr;
  }
  .appreciate-list li{
    counter-increment:appr;
    position:relative;
    padding:1rem 0 1rem 3rem;
    border-bottom:1px solid var(--border-subtle);
    color:var(--text-main);
  }
  .appreciate-list li:last-child{border-bottom:none;}
  .appreciate-list li::before{
    content:counter(appr,decimal-leading-zero);
    position:absolute;
    left:0;top:1rem;
    font-family:'Comfortaa',cursive;
    font-weight:700;
    color:var(--accent);
    font-size:1rem;
    text-shadow:0 0 8px var(--accent-glow);
  }

  .before-after{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:1rem;
    margin-top:1.2rem;
  }
  .ba-card{
    background:var(--bg-card);
    border:1px solid var(--border-subtle);
    border-radius:12px;
    padding:1.3rem;
    transition:all .3s ease;
  }
  .ba-card:hover{
    border-color:var(--accent);
    box-shadow:0 0 18px var(--accent-glow);
  }
  .ba-label{
    font-family:'Comfortaa',cursive;
    font-weight:700;
    font-size:.85rem;
    color:var(--accent);
    text-transform:uppercase;
    letter-spacing:.08em;
    margin-bottom:.6rem;
    display:block;
  }
  .ba-card p{color:var(--text-main);font-size:.95rem;margin:0;}

  .tracklist{list-style:none;padding:0;}
  .tracklist li{
    display:flex;align-items:center;gap:1rem;
    padding:1rem 1.2rem;margin-bottom:.7rem;
    background:var(--bg-card);
    border:1px solid var(--border-subtle);
    border-radius:10px;
    transition:all .3s ease;
  }
  .tracklist li:hover{
    border-color:var(--accent);
    box-shadow:0 0 18px var(--accent-glow);
    transform:translateX(4px);
  }
  .track-num{
    font-family:'Comfortaa',cursive;
    font-weight:700;font-size:1.1rem;
    color:var(--accent);min-width:2rem;
    text-shadow:0 0 8px var(--accent-glow);
  }
  .track-info{
    display:flex;flex-direction:column;flex:1;min-width:0;
  }
  .track-title{
    font-family:'Nunito',sans-serif;font-weight:600;
    color:var(--text-main);font-size:1rem;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  .track-artist{font-size:.85rem;color:var(--text-muted);}
  .track-count{
    font-family:'Comfortaa',cursive;font-weight:600;
    font-size:.9rem;color:var(--accent);white-space:nowrap;
  }

  .playlist-item{
    background:var(--bg-card);
    border:1px solid var(--border-subtle);
    border-radius:12px;
    padding:1.3rem 1.5rem;
    margin-bottom:.9rem;
    transition:all .3s ease;
  }
  .playlist-item:hover{
    border-color:var(--accent);
    box-shadow:0 0 18px var(--accent-glow);
  }
  .playlist-item .pl-title{
    font-family:'Comfortaa',cursive;
    font-weight:600;
    color:var(--accent);
    font-size:1rem;
    margin-bottom:.3rem;
  }
  .playlist-item .pl-artist{
    font-size:.85rem;
    color:var(--text-muted);
    margin-bottom:.6rem;
  }
  .playlist-item .pl-why{
    font-size:.95rem;
    color:var(--text-main);
    font-style:italic;
    border-left:2px solid var(--border-subtle);
    padding-left:.9rem;
  }

  .eggs{
    display:flex;flex-wrap:wrap;gap:.8rem;justify-content:center;
    margin-top:1.8rem;
  }
  .egg{
    width:54px;height:54px;
    border:1px solid var(--border-subtle);
    border-radius:12px;
    background:var(--bg-card-2);
    display:flex;align-items:center;justify-content:center;
    font-size:1.35rem;
    cursor:pointer;
    transition:all .3s ease;
  }
  .egg:hover{
    border-color:var(--accent);
    box-shadow:0 0 14px var(--accent-glow);
    transform:scale(1.08);
  }
  .egg.warm{
    border-color:rgba(168,255,96,.5);
    background:linear-gradient(135deg, rgba(168,255,96,.08), transparent);
  }
  .egg.warm:hover{
    box-shadow:0 0 22px var(--accent-glow);
  }

  .modal-backdrop{
    position:fixed;inset:0;
    background:rgba(0,0,0,.85);
    backdrop-filter:blur(6px);
    display:none;
    align-items:center;justify-content:center;
    z-index:100;padding:1.5rem;
  }
  .modal-backdrop.active{display:flex;}
  .modal{
    background:var(--bg-card);
    border:1px solid var(--accent);
    border-radius:14px;
    padding:1.8rem;
    max-width:480px;
    box-shadow:0 0 35px var(--accent-glow);
    text-align:center;
    animation:pop .3s ease;
  }
  @keyframes pop{from{transform:scale(.92);opacity:0;}to{transform:scale(1);opacity:1;}}
  .modal p{color:var(--text-main);margin-bottom:1.4rem;}
  .btn{
    display:inline-block;
    padding:.7rem 1.8rem;
    border:1px solid var(--accent);
    color:var(--accent);
    font-family:'Nunito',sans-serif;
    font-size:.9rem;font-weight:600;
    letter-spacing:.03em;
    border-radius:8px;
    background:transparent;
    cursor:pointer;
    transition:all .3s ease;
  }
  .btn:hover{
    background:var(--accent);
    color:var(--bg-dark);
    box-shadow:0 0 18px var(--accent-glow);
  }

  .final{text-align:center;padding:4.5rem 1.5rem 3rem;}
  .final p{max-width:560px;margin:0 auto 1rem;color:var(--text-muted);}
  .final .thanks{font-size:1.15rem;color:var(--text-main);margin-bottom:1.4rem;}

  footer{
    text-align:center;padding:1.8rem 1rem;
    font-size:.8rem;color:#555;
    border-top:1px solid var(--border-subtle);
  }

  @media (max-width:600px){
    section{padding:2.8rem 0;}
    .card{padding:1.3rem;}
    .hero{padding:3rem 1.2rem 2.5rem;}
    .tracklist li{padding:.8rem .9rem;gap:.7rem;}
    .track-title{font-size:.92rem;}
    .track-count{font-size:.8rem;}
    .before-after{grid-template-columns:1fr;}
    .accent-block{padding:1.4rem 1.2rem;}
    .appreciate-list li{padding-left:2.4rem;}
  }
</style>
</head>
<body>

<canvas id="hearts-bg" aria-hidden="true"></canvas>

<div class="page">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <h1>Для Ники</h1>
      <p class="subtitle">
        Этот сайт был сделан для того, чтобы ты улыбнулась — даже в самый тяжёлый момент.
      </p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- ABOUT -->
  <section id="about">
    <div class="container">
      <h2 class="reveal">О тебе</h2>
      <p class="muted reveal" style="margin-bottom:2rem;">То, что я запомнил. Возможно, не всё — но важное.</p>

      <div class="card reveal">
        <h3>Твои интересы</h3>
        <ul>
          <li><strong>Аниме и манхва:</strong> Code Geass, Иная, «Пощади меня, Великий господин» (ждём 3 сезон), «Выбери меня!», «Я прокачиваюсь во сне».</li>
          <li><strong>Игры:</strong> Mobile Legends (Кагура, Селена), DBD, Apex (Эш, Октан, Ваттсон).</li>
          <li><strong>Музыка:</strong> Korn, индастриал, готик-метал, Noctyra, Tommee Profitt.</li>
          <li><strong>Рисование:</strong> арты на заказ, тёмные тона, «самостоятельные» девушки в образах.</li>
        </ul>
      </div>

      <div class="card reveal">
        <h3>Твои слова, которые я запомнил</h3>
        <div class="quote">«Пизды отхватишь» <span class="author">— я стараюсь не нарываться</span></div>
        <div class="quote">«Я работаю, чтобы выжить» <span class="author">— и я хочу, чтобы тебе не приходилось делать это в одиночку</span></div>
        <div class="quote">«Я живу, чтобы страдать» <span class="author">— а я хочу, чтобы у тебя было хоть немного меньше поводов так думать</span></div>
        <div class="quote">«Думай, Твизи, думай» <span class="author">— и я думаю. Правда.</span></div>
        <div class="quote">«Мне похуй» <span class="author">— я знаю, что это не всегда так. И когда тебе не похуй — я рядом</span></div>
      </div>

      <div class="card reveal">
        <h3>Твои предпочтения</h3>
        <ul>
          <li>Чокеры и подвески на шею</li>
          <li>Тёмные тона в одежде</li>
          <li>Кофе с отборными зёрнами</li>
          <li>Мармеладки и острые роллы</li>
          <li>Атмосферные треки на репите</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- APPRECIATE -->
  <section id="appreciate">
    <div class="container">
      <h2 class="reveal">Что я в тебе ценю</h2>
      <p class="muted reveal" style="margin-bottom:1.5rem;">
        Не общие слова. То, что я вижу каждый день в переписке.
      </p>

      <ul class="appreciate-list reveal">
        <!-- Удалён пункт про работу до изнеможения -->
        <li>Ты помогаешь подруге с высшей математикой, хотя сама устаёшь. Это много говорит о тебе.</li>
        <li>Ты не боишься говорить «похуй» и «пизды отхватишь» — и в этом больше честности, чем в сотне вежливых фраз.</li>
        <li>Ты настолько преданна работе, что несмотря на извращенцев всё равно сделаешь её, как бы тебе ни было противно.</li>
        <li>Ты умеешь признавать, что тебе плохо. Не все на это способны.</li>
        <li>Ты защищаешь тех, кто тебе дорог, — даже когда сама еле стоишь.</li>
        <li>Ты не притворяешься. Ни в хорошем, ни в плохом. И это — редкость.</li>
      </ul>
    </div>
  </section>

  <div class="divider"></div>

  <!-- ONE THING -->
  <section id="one-thing">
    <div class="container">
      <h2 class="reveal">Одна вещь, которую я понял о тебе</h2>
      <div class="accent-block reveal">
        <p>
          Ты не холодная. Ты просто устала быть той, кто всегда справляется сама.
          И я не собираюсь это менять — я просто хочу, чтобы ты знала:
          рядом есть кто-то, кто не отвернётся, когда ты устанешь.
        </p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- FEELINGS -->
  <section id="feelings">
    <div class="container">
      <h2 class="reveal">Что я чувствую</h2>
      <div class="card reveal">
        <p>Начну с главного: я уважаю твою позицию. Ты не раз говорила, что не хочешь отношений и не веришь в любовь — и я не собираюсь это оспаривать или давить. Твои границы для меня не каприз, а часть тебя, которую я принимаю.</p>
        <p>Я хочу быть тем, кто поможет тебе в любой жизненной ситуации. Не потому, что жду чего-то взамен, а потому что ты мне дорога. Если тебе плохо — я рядом. Если тебе нужно пространство — я отойду. Если нужна помощь — я сделаю всё, что в моих силах. Без условий и без счёта.</p>
        <p>Этот сайт я готовил неделю. Бессонные ночи, литровые кружки кофе за ночь, и все мысли — только о тебе. Я не надеялся ни на что, когда делал его. Просто хотел, чтобы ты знала: есть человек, который слушал, запоминал и вкладывал время не ради ответа, а потому что ты этого стоишь.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- WISHES -->
  <section id="wishes">
    <div class="container">
      <h2 class="reveal">Что я хочу сделать для тебя</h2>
      <p class="muted reveal" style="margin-bottom:1.5rem;">
        Без громких обещаний. Просто то, что я действительно хочу.
      </p>
      <div class="card reveal">
        <ul>
          <li>Хочу, чтоб ты хоть раз поела так, чтоб аж спать потянуло (желательно чтоб рядом был я).</li>
          <li>Хочу, чтоб ты чаще спала больше пяти часов.</li>
          <li>Хочу, чтобы ты улыбнулась, даже когда всё идёт по одному месту.</li>
          <li>Хочу, чтобы у тебя было чуть больше причин сказать «мне хорошо», а не «ужасно».</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- BEFORE AFTER -->
  <section id="before-after">
    <div class="container">
      <h2 class="reveal">До и после</h2>
      <p class="muted reveal" style="margin-bottom:1rem;">
        Маленькая деталь, которая показывает, что я слушал.
      </p>
      <div class="before-after reveal">
        <div class="ba-card">
          <span class="ba-label">До</span>
          <p>Раньше я думал, что мне нужно стать твоим идеалом, чтоб ты меня полюбила.</p>
        </div>
        <div class="ba-card">
          <span class="ba-label">После</span>
          <p>Теперь я знаю, что для этого достаточно быть самим собой и быть рядом.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- MUSIC TOP -->
  <section id="music">
    <div class="container">
      <h2 class="reveal">Топ-10 треков за полгода</h2>
      <p class="muted reveal" style="margin-bottom:2rem;">
        Песни, которые я слушал чаще всего за эти полгода плотного общения с тобой.
      </p>

      <ol class="tracklist reveal">
        <li>
          <span class="track-num">01</span>
          <div class="track-info">
            <span class="track-title">Любимая</span>
            <span class="track-artist">whyspurky</span>
          </div>
          <span class="track-count">283 раза</span>
        </li>
        <li>
          <span class="track-num">02</span>
          <div class="track-info">
            <span class="track-title">Слишком влюблён</span>
            <span class="track-artist">Нервы</span>
          </div>
          <span class="track-count">263 раза</span>
        </li>
        <li>
          <span class="track-num">03</span>
          <div class="track-info">
            <span class="track-title">Deep End</span>
            <span class="track-artist">Noro</span>
          </div>
          <span class="track-count">219 раз</span>
        </li>
        <li>
          <span class="track-num">04</span>
          <div class="track-info">
            <span class="track-title">Тело</span>
            <span class="track-artist">Панкмодернисты</span>
          </div>
          <span class="track-count">214 раз</span>
        </li>
        <li>
          <span class="track-num">05</span>
          <div class="track-info">
            <span class="track-title">Дом Периньон</span>
            <span class="track-artist">Пошлая Молли и Элджей</span>
          </div>
          <span class="track-count">181 раз</span>
        </li>
        <li>
          <span class="track-num">06</span>
          <div class="track-info">
            <span class="track-title">Baby My Type</span>
            <span class="track-artist">Take Take</span>
          </div>
          <span class="track-count">178 раз</span>
        </li>
        <li>
          <span class="track-num">07</span>
          <div class="track-info">
            <span class="track-title">Нет сердца</span>
            <span class="track-artist">Owar1</span>
          </div>
          <span class="track-count">134 раза</span>
        </li>
        <li>
          <span class="track-num">08</span>
          <div class="track-info">
            <span class="track-title">Зажигалка</span>
            <span class="track-artist">Нервы</span>
          </div>
          <span class="track-count">92 раза</span>
        </li>
        <li>
          <span class="track-num">09</span>
          <div class="track-info">
            <span class="track-title">Падаем на игле</span>
          </div>
          <span class="track-count">78 раз</span>
        </li>
        <li>
          <span class="track-num">10</span>
          <div class="track-info">
            <span class="track-title">Black Out Days (Stay Away)</span>
            <span class="track-artist">Phantogram</span>
          </div>
          <span class="track-count">47 раз</span>
        </li>
      </ol>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PLAYLIST -->
  <section id="playlist">
